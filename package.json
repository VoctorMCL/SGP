{
  "name": "sgp",
  "version": "1.0.0",
  "description": "SGP - Sistema de Gestión de Parqueo (Fullstack Angular + Express + MongoDB)",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:ui": "ng serve",
    "build": "ng build",
    "seed": "node backend/seed.js",
    "mobile:ip": "node scripts/set-mobile-ip.js",
    "build:mobile": "npm run mobile:ip && ng build && npx cap sync android",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android"
  },
  "keywords": [
    "parqueadero",
    "angular",
    "express",
    "mongodb",
    "vercel"
  ],
  "author": "Victor Cordoba & Ricardo Jaraba",
  "license": "ISC",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "jwt-simple": "^0.5.6",
    "leaflet": "^1.9.4",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.5",
    "mongoose": "^9.10.4",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "glob": "^10.4.5",
    "minimatch": "^10.0.1",
    "rimraf": "^6.0.1",
    "uuid": "^11.1.1",
    "vite": "^6.3.5",
    "@capacitor/cli": {
      "glob": "^10.4.5",
      "minimatch": "^10.0.1",
      "rimraf": "^6.0.1"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
